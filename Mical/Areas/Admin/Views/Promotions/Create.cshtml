@model PromotionFormVm
@{
    ViewData["Title"] = "Nueva promoción";
}

<div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
    <h1 class="h3 mb-0">Nueva promoción</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>

<div class="card border-0 shadow-sm" style="max-width:760px;">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Subtitle" class="form-label"></label>
                <input asp-for="Subtitle" class="form-control" />
                <span asp-validation-for="Subtitle" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Image" class="form-label"></label>
                <input asp-for="Image" type="file" accept="image/*" class="form-control" />
                <div class="form-text">JPG, PNG o WEBP. Máx. 2 MB. Ideal apaisada (ej. 1200×400).</div>
                <span asp-validation-for="Image" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" type="number" min="0" class="form-control" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="StartsAt" class="form-label"></label>
                    <input asp-for="StartsAt" type="date" class="form-control" />
                    <span asp-validation-for="StartsAt" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EndsAt" class="form-label"></label>
                    <input asp-for="EndsAt" type="date" class="form-control" />
                    <span asp-validation-for="EndsAt" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-dark px-4">Crear</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
