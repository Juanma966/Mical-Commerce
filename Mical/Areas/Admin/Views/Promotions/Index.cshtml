@model IReadOnlyList<AdminPromotionListItemVm>
@{
    ViewData["Title"] = "Promociones";
}

<div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
    <h1 class="h3 mb-0">Promociones</h1>
    <a class="btn btn-dark" asp-action="Create">Nueva promoción</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Todavía no hay promociones. Creá el primer banner de la home.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead>
                <tr>
                    <th></th>
                    <th>Título</th>
                    <th class="text-center">Orden</th>
                    <th>Vigencia</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="width:72px;">
                            @if (!string.IsNullOrEmpty(p.ImagePath))
                            {
                                <img src="~/@p.ImagePath" alt="@p.Title" width="64" height="40" style="object-fit:cover;border-radius:6px;" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="d-inline-block bg-light border rounded" style="width:64px;height:40px;"></span>
                            }
                        </td>
                        <td>@p.Title</td>
                        <td class="text-center">@p.DisplayOrder</td>
                        <td class="small text-muted">
                            @(p.StartsAt?.ToString("dd/MM/yyyy") ?? "—") → @(p.EndsAt?.ToString("dd/MM/yyyy") ?? "—")
                        </td>
                        <td>
                            @if (p.IsVisibleNow)
                            {
                                <span class="badge bg-success">Visible</span>
                            }
                            else if (p.IsActive)
                            {
                                <span class="badge bg-secondary">Activa (fuera de fecha)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                        @(p.IsActive ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
