@model ProductDetailVm
@{
    ViewData["Title"] = Model.Name;

    var seoDesc = !string.IsNullOrWhiteSpace(Model.Description)
        ? Model.Description!.Trim()
        : $"{Model.Name} — disponible en Mical, tu librería y regalería cristiana. Comprá online con envíos a todo el país.";
    if (seoDesc.Length > 160)
    {
        seoDesc = seoDesc.Substring(0, 157).TrimEnd() + "…";
    }
    ViewData["Description"] = seoDesc;
    ViewData["OgType"] = "product";
    if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        ViewData["OgImage"] = Model.ImagePath;
    }
}

<section class="py-5" style="margin-top:90px;">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none">Tienda</a></li>
                <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" asp-route-categoria="@Model.CategoryId" class="text-decoration-none">@Model.CategoryName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>

        <div class="row g-5">
            <div class="col-md-6">
                <div class="bg-light rounded" style="aspect-ratio:1/1;overflow:hidden;">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="~/@Model.ImagePath" alt="@Model.Name" class="w-100 h-100" style="object-fit:cover;" fetchpriority="high" decoding="async" />
                    }
                </div>
            </div>

            <div class="col-md-6">
                <p class="text-muted small text-uppercase mb-1">@Model.CategoryName</p>
                <h1 class="h2 mb-3">@Model.Name</h1>

                <div class="mb-3">
                    @if (Model.IsOnSale)
                    {
                        <span class="text-decoration-line-through text-muted me-2 fs-5">@Model.Price.ToMoney()</span>
                        <span class="fs-3 fw-bold">@Model.EffectivePrice.ToMoney()</span>
                        <span class="badge bg-success ms-2">Oferta</span>
                    }
                    else
                    {
                        <span class="fs-3 fw-bold">@Model.EffectivePrice.ToMoney()</span>
                    }
                </div>

                @if (Model.IsOutOfStock)
                {
                    <p><span class="badge bg-danger">Sin stock</span></p>
                    <button type="button" class="btn btn-dark btn-lg px-4" disabled>Agregar al carrito</button>
                }
                else
                {
                    <p class="text-success small mb-3">Disponible · @Model.Stock en stock</p>
                    <div class="d-flex align-items-center gap-2" style="max-width:340px;">
                        <input id="qty" type="number" value="1" min="1" max="@Model.Stock" class="form-control" style="width:90px;" />
                        <button type="button" class="btn btn-dark btn-lg px-4 js-add-to-cart flex-grow-1"
                                data-product-id="@Model.Id" data-qty-target="#qty" data-product-name="@Model.Name" data-label="Agregar al carrito">
                            Agregar al carrito
                        </button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr class="my-4" />
                    <h6 class="text-uppercase text-muted">Descripción</h6>
                    <p class="mb-0" style="white-space:pre-line;">@Model.Description</p>
                }

                <hr class="my-4" />
                <p class="text-muted small mb-0">SKU: @Model.Sku</p>
            </div>
        </div>

        @if (Model.Related.Any())
        {
            <div class="mt-5 pt-4 border-top">
                <h2 class="h4 mb-4">Productos relacionados</h2>
                <div class="row g-4">
                    @foreach (var item in Model.Related)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-reset">
                                    <div class="position-relative bg-light" style="aspect-ratio:1/1;overflow:hidden;">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="~/@item.ImagePath" alt="@item.Name" class="w-100 h-100" style="object-fit:cover;" loading="lazy" decoding="async" />
                                        }
                                        @if (item.IsOutOfStock)
                                        {
                                            <span class="badge bg-danger position-absolute top-0 start-0 m-2">Sin stock</span>
                                        }
                                        else if (item.IsOnSale)
                                        {
                                            <span class="badge bg-success position-absolute top-0 start-0 m-2">Oferta</span>
                                        }
                                    </div>
                                    <div class="card-body">
                                        <h6 class="card-title mb-1">@item.Name</h6>
                                        <div>
                                            @if (item.IsOnSale)
                                            {
                                                <span class="text-decoration-line-through text-muted me-1">@item.Price.ToMoney()</span>
                                                <strong>@item.EffectivePrice.ToMoney()</strong>
                                            }
                                            else
                                            {
                                                <strong>@item.EffectivePrice.ToMoney()</strong>
                                            }
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
