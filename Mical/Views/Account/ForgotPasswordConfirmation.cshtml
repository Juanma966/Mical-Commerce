@{
    ViewData["Title"] = "Revisá tu email";
    ViewData["NoIndex"] = true;
}

<section class="auth-section py-5" style="margin-top:100px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5 text-center">
                        <h1 class="h3 mb-3">Revisá tu email</h1>
                        <p class="text-muted mb-4">
                            Si existe una cuenta con ese email, te enviamos un enlace para restablecer
                            tu contraseña. Revisá tu bandeja de entrada (y la carpeta de spam).
                        </p>
                        <a asp-action="Login" class="btn btn-dark px-4">Volver a iniciar sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
