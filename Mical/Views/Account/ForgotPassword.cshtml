@model ForgotPasswordVm
@{
    ViewData["Title"] = "Recuperar contraseña";
    ViewData["NoIndex"] = true;
}

<section class="auth-section py-5" style="margin-top:100px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h3 mb-2 text-center">Recuperar contraseña</h1>
                        <p class="text-muted text-center mb-4">
                            Ingresá tu email y te enviaremos un enlace para restablecerla.
                        </p>

                        <form asp-action="ForgotPassword" method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-dark w-100 py-2">Enviar enlace</button>
                        </form>

                        <p class="text-center mt-4 mb-0">
                            <a asp-action="Login">Volver a iniciar sesión</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
