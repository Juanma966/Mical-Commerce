@model HomeIndexVm
@{
    ViewData["Title"] = "Inicio";
    ViewData["Description"] = "Mical — Librería y Regalería Cristiana. Biblias, libros, regalos y artículos de imprenta con diseño. Comprá online con envíos a todo el país.";
}

@*
    Home pública. Promociones y "productos destacados" salen de la base (admin/catálogo).
    El resto de secciones (blog, instagram) sigue con datos de muestra del maquetado.
*@

<section id="billboard" class="position-relative overflow-hidden" style="margin-top:104px;">
    <a asp-controller="Shop" asp-action="Index" class="d-block" title="Ir a la tienda">
        <img src="~/images/mical-hero-banner.webp" alt="Mical — Tu librería cristiana en casa" class="w-100 d-block" fetchpriority="high" decoding="async" />
    </a>
    <div class="text-center py-4">
        <a asp-controller="Shop" asp-action="Index" class="btn btn-medium btn-dark text-uppercase btn-rounded-none">Ver productos</a>
    </div>
</section>

@if (Model.Promotions.Any())
{
    <section id="promotions" class="container my-4">
        <div class="row g-3">
            @foreach (var promo in Model.Promotions)
            {
                <div class="col-12 @(Model.Promotions.Count > 1 ? "col-md-6" : "")">
                    <div class="promo-banner position-relative rounded overflow-hidden h-100">
                        @if (!string.IsNullOrEmpty(promo.ImagePath))
                        {
                            <img src="~/@promo.ImagePath" alt="@promo.Title" class="promo-banner__img" loading="lazy" decoding="async" />
                        }
                        <div class="promo-banner__body @(string.IsNullOrEmpty(promo.ImagePath) ? "promo-banner__body--solid" : "")">
                            <h3 class="promo-banner__title">@promo.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(promo.Subtitle))
                            {
                                <p class="promo-banner__subtitle mb-0">@promo.Subtitle</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section id="company-services" class="padding-large">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-6 pb-3">
                <div class="icon-box d-flex">
                    <div class="icon-box-icon pe-3 pb-3">
                        <svg class="cart-outline"><use xlink:href="#cart-outline" /></svg>
                    </div>
                    <div class="icon-box-content">
                        <h3 class="card-title text-uppercase text-dark">Envío a domicilio</h3>
                        <p>Recibí tu compra en todo el país.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 pb-3">
                <div class="icon-box d-flex">
                    <div class="icon-box-icon pe-3 pb-3">
                        <svg class="quality"><use xlink:href="#quality" /></svg>
                    </div>
                    <div class="icon-box-content">
                        <h3 class="card-title text-uppercase text-dark">Calidad garantizada</h3>
                        <p>Productos seleccionados con dedicación.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 pb-3">
                <div class="icon-box d-flex">
                    <div class="icon-box-icon pe-3 pb-3">
                        <svg class="price-tag"><use xlink:href="#price-tag" /></svg>
                    </div>
                    <div class="icon-box-content">
                        <h3 class="card-title text-uppercase text-dark">Ofertas semanales</h3>
                        <p>Descuentos en productos seleccionados.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 pb-3">
                <div class="icon-box d-flex">
                    <div class="icon-box-icon pe-3 pb-3">
                        <svg class="shield-plus"><use xlink:href="#shield-plus" /></svg>
                    </div>
                    <div class="icon-box-content">
                        <h3 class="card-title text-uppercase text-dark">Pago 100% seguro</h3>
                        <p>Tus datos siempre protegidos.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.Featured.Any())
{
    <section id="mobile-products" class="product-store position-relative padding-large no-padding-top">
        <div class="container">
            <div class="row">
                <div class="display-header d-flex justify-content-between pb-3">
                    <h2 class="display-7 text-dark text-uppercase">Productos destacados</h2>
                    <div class="btn-right">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-medium btn-normal text-uppercase">Ver tienda</a>
                    </div>
                </div>
                <div class="swiper product-swiper">
                    <div class="swiper-wrapper">
                        @foreach (var item in Model.Featured)
                        {
                            <div class="swiper-slide">
                                <div class="product-card position-relative">
                                    <div class="image-holder">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="d-block">
                                            @if (!string.IsNullOrEmpty(item.ImagePath))
                                            {
                                                <img src="~/@item.ImagePath" alt="@item.Name" class="img-fluid" loading="lazy" decoding="async">
                                            }
                                            else
                                            {
                                                <span class="d-block bg-light w-100" style="aspect-ratio:1/1;"></span>
                                            }
                                        </a>
                                        @if (item.IsOutOfStock)
                                        {
                                            <span class="badge bg-danger position-absolute top-0 start-0 m-2">Sin stock</span>
                                        }
                                        else if (item.IsOnSale)
                                        {
                                            <span class="badge bg-success position-absolute top-0 start-0 m-2">Oferta</span>
                                        }
                                    </div>
                                    @if (!item.IsOutOfStock)
                                    {
                                        <div class="cart-concern position-absolute">
                                            <div class="cart-button d-flex">
                                                <a href="#" class="btn btn-medium btn-black js-add-to-cart"
                                                   data-product-id="@item.Id" data-product-name="@item.Name">
                                                    Agregar al carrito<svg class="cart-outline"><use xlink:href="#cart-outline"></use></svg>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    <div class="card-detail d-flex justify-content-between align-items-baseline pt-3">
                                        <h3 class="card-title text-uppercase">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                                        </h3>
                                        <span class="item-price text-primary">
                                            @if (item.IsOnSale)
                                            {
                                                <span class="text-decoration-line-through text-muted me-1">@item.Price.ToMoney()</span>
                                            }
                                            @item.EffectivePrice.ToMoney()
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="swiper-pagination position-absolute text-center"></div>
    </section>
}

<section id="yearly-sale" class="overflow-hidden mt-5">
    <a asp-controller="Shop" asp-action="Index" class="d-block" title="Ver ofertas">
        <img src="~/images/mical-hero-banner.webp" alt="Ofertas de temporada" class="w-100 d-block" loading="lazy" decoding="async" />
    </a>
</section>

<section id="subscribe" class="container-grid padding-large position-relative overflow-hidden">
    <div class="container">
        <div class="row">
            <div class="subscribe-content bg-dark d-flex flex-wrap justify-content-center align-items-center padding-medium">
                <div class="col-md-6 col-sm-12">
                    <div class="display-header pe-3">
                        <h2 class="display-7 text-uppercase text-light">Suscribite</h2>
                        <p>Recibí novedades, actualizaciones y ofertas directamente en tu correo.</p>
                    </div>
                </div>
                <div class="col-md-5 col-sm-12">
                    <form class="subscription-form validate">
                        <div class="input-group flex-wrap">
                            <input class="form-control btn-rounded-none" type="email" name="EMAIL" placeholder="Tu correo electrónico" required>
                            <button class="btn btn-medium btn-primary text-uppercase btn-rounded-none" type="submit" name="subscribe">Suscribir</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
